{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Snowplane Operator — Reconciliation, Snowflake API, Drift Detection, Managed Resources",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Reconciliation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_reconcile_total{result=\"success\"}[$__rate_interval])) by (controller)",
          "legendFormat": "{{ controller }} success"
        },
        {
          "expr": "sum(rate(snowplane_reconcile_total{result=\"error\"}[$__rate_interval])) by (controller)",
          "legendFormat": "{{ controller }} error"
        }
      ],
      "title": "Reconcile Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(snowplane_reconcile_duration_seconds_bucket[$__rate_interval])) by (controller, le))",
          "legendFormat": "{{ controller }} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(snowplane_reconcile_duration_seconds_bucket[$__rate_interval])) by (controller, le))",
          "legendFormat": "{{ controller }} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(snowplane_reconcile_duration_seconds_bucket[$__rate_interval])) by (controller, le))",
          "legendFormat": "{{ controller }} p99"
        }
      ],
      "title": "Reconcile Duration (P50 / P95 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_reconcile_total{result=\"error\"}[$__rate_interval])) by (controller)",
          "legendFormat": "{{ controller }}"
        }
      ],
      "title": "Reconcile Error Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 10,
      "title": "Snowflake API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 11,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(snowplane_snowflake_operation_duration_seconds_bucket[$__rate_interval])) by (operation, le))",
          "legendFormat": "{{ operation }} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(snowplane_snowflake_operation_duration_seconds_bucket[$__rate_interval])) by (operation, le))",
          "legendFormat": "{{ operation }} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(snowplane_snowflake_operation_duration_seconds_bucket[$__rate_interval])) by (operation, le))",
          "legendFormat": "{{ operation }} p99"
        }
      ],
      "title": "Snowflake API Latency (P50 / P95 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 12,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_snowflake_operation_total[$__rate_interval])) by (operation, result)",
          "legendFormat": "{{ operation }} {{ result }}"
        }
      ],
      "title": "Snowflake API Operations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 13,
      "options": {},
      "targets": [
        {
          "expr": "snowplane_client_pool_size",
          "legendFormat": "pool size"
        }
      ],
      "title": "Client Pool Size",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 14,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_rate_limit_waits_total[$__rate_interval])) by (controller)",
          "legendFormat": "{{ controller }}"
        }
      ],
      "title": "Rate Limit Waits",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 20,
      "title": "Drift & Adoption",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 21,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_drift_detected_total[$__rate_interval])) by (controller)",
          "legendFormat": "{{ controller }}"
        }
      ],
      "title": "Drift Detection Frequency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 22,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_adoption_total[$__rate_interval])) by (controller, result)",
          "legendFormat": "{{ controller }} {{ result }}"
        }
      ],
      "title": "Adoption Outcomes",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 30,
      "title": "Managed Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "id": 31,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "snowplane_managed_resources",
          "legendFormat": "{{ controller }} {{ state }}"
        }
      ],
      "title": "Managed Resources by Controller & State",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "id": 40,
      "title": "Circuit Breaker",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [{"type": "value", "options": {"0": {"text": "Closed", "color": "green"}, "1": {"text": "Open", "color": "red"}, "2": {"text": "Half-Open", "color": "yellow"}}}] },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "id": 41,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "snowplane_circuit_breaker_state",
          "legendFormat": "{{ provider }}"
        }
      ],
      "title": "Circuit Breaker State",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
      "id": 42,
      "options": { "legend": { "displayMode": "table" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(snowplane_circuit_breaker_trips_total[$__rate_interval])) by (provider)",
          "legendFormat": "{{ provider }}"
        }
      ],
      "title": "Circuit Breaker Trips",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 },
      "id": 50,
      "title": "ProviderConfig Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "Unhealthy", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "Healthy", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 62 },
      "id": 51,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "snowplane_providerconfig_healthy",
          "legendFormat": "{{ provider }} ({{ account }})"
        }
      ],
      "title": "ProviderConfig Health Status",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["snowplane", "kubernetes", "snowflake"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(snowplane_reconcile_total, controller)",
        "includeAll": true,
        "label": "Controller",
        "multi": true,
        "name": "controller",
        "query": "label_values(snowplane_reconcile_total, controller)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Snowplane Operator",
  "uid": "snowplane-operator",
  "version": 1
}
